    {"id": "g1", "type": "group", "x": 0, "y": 0, "width": 420, "height": 460, "label": "Claude Code", "color": "6"},
    {"id": "c1", "type": "text", "text": "**Planifica**\nInvestiga, diseña, crea TASK-NNN (estado `lista`), fichas RES y UI.", "x": 20, "y": 60, "width": 380, "height": 110},
    {"id": "c2", "type": "text", "text": "**Revisa**\nComprueba evidencias; marca `hecha` o crea TASK-NNN-fix / registra error.", "x": 20, "y": 300, "width": 380, "height": 110},
